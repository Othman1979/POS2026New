# POSApp provider-neutral intake API. Keep the raw key only on this gateway.
ORDER_INTAKE_BASE_URL=http://127.0.0.1:3000
ORDER_INTAKE_API_KEY=

# Durable local state. Leave unset for the current user's protected local data directory.
# ORDER_GATEWAY_OUTBOX_PATH=C:\Users\you\AppData\Local\POSApp\GeminiOrderGateway\order-gateway.sqlite
ORDER_GATEWAY_REQUEST_TIMEOUT_MS=10000
ORDER_GATEWAY_RECOVERY_DELAY_MS=250

# Required for Gemini Live. Never commit the real key.
GEMINI_API_KEY=
GEMINI_RETRY_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_DELAY_MS=750

# Local microphone/speaker gateway. The HTTP server always binds to loopback.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
VOICE_GATEWAY_PORT=3199
VOICE_GATEWAY_MAX_SESSIONS=32

# Optional UCM6301 private-LAN SIP registration probe. Do not route live calls yet.
# Set the listener to this PC's private LAN IP, not 0.0.0.0.
UCM_SIP_SERVER=
UCM_SIP_LISTEN=
UCM_SIP_EXTENSION=
UCM_SIP_AUTH_ID=
UCM_SIP_PASSWORD=
