{
  "name": "posapp",
  "version": "1.0.9",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:admin": "vite --host 127.0.0.1",
    "build": "npm run fontawesome:verify && vite build && node scripts/verify-production-build.cjs",
    "build:admin": "npm run fontawesome:verify && vite build && node scripts/verify-production-build.cjs",
    "fontawesome:build": "node scripts/build-fontawesome-subset.cjs",
    "fontawesome:verify": "node scripts/verify-fontawesome-subset.cjs",
    "lint:vue": "eslint src",
    "test": "npm run build:admin",
    "pretest:unit": "node scripts/validate-schema-drift.js",
    "test:unit": "vitest run",
    "test:frontend": "vitest run --config vitest.frontend.config.mjs",
    "test:isolated": "node scripts/test-isolated.cjs",
    "test:isolated:shards": "node scripts/test-isolated-shards.cjs",
    "test:release-browser": "node scripts/ci/release-browser.cjs",
    "pretest:e2e": "node scripts/validate-schema-drift.js",
    "test:e2e": "playwright test",
    "test:installer": "vitest run backend/tests/unit/installerConfig.test.js backend/tests/unit/installerCli.test.js backend/tests/unit/installerPackageContract.test.js backend/tests/unit/installerUpdateContract.test.js backend/tests/unit/dbBackupCli.test.js backend/tests/integration/installerBaseline.test.js",
    "build:installers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installers.ps1",
    "prepare:deployment": "node scripts/prepare-deployment-kit.cjs",
    "order-intake:key": "node scripts/generate-order-intake-key.cjs",
    "order-intake:simulate": "node scripts/order-intake-simulator.cjs",
    "gateway:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-go-order-gateway.ps1 -Action build",
    "gateway:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-go-order-gateway.ps1 -Action test",
    "gateway:simulate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-go-order-gateway.ps1 -Action simulate",
    "gateway:voice": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-go-order-gateway.ps1 -Action voice",
    "gateway:voice:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-go-order-gateway.ps1 -Action local",
    "gateway:ucm:probe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-go-order-gateway.ps1 -Action ucm-probe",
    "architecture": "node scripts/build-architecture.js",
    "architecture:check": "node scripts/build-architecture.js --check",
    "release:spooler": "node scripts/bump-installer-versions.js --only spooler --commit && npm run build:installers -- -SkipVersionBump"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vueuse/core": "15.0.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "html2pdf.js": "^0.14.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.4",
    "pinia": "^4.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.0",
    "vite": "^8.3.0",
    "vue": "^3.5.43",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "^5.3.1",
    "vue3-moveable": "0.28.0",
    "vue3-selecto": "1.12.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "subset-font": "^2.7.0",
    "supertest": "^7.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
