NODE_ENV=production
PORT=3100
DEVICE_AUTH_ALLOWED_ORIGINS=https://hashemi.shawermajwana.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME={{DB_NAME}}
DB_USER={{DB_USER}}
DB_PASSWORD={{DB_PASSWORD}}
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
ENFORCE_HTTPS=true
FORM_BODY_LIMIT=1mb
JSON_BODY_LIMIT=2mb
LOG_LEVEL=info
SESSION_IDLE_TIMEOUT_MS=1800000
SPOOLER_KEY={{SPOOLER_KEY}}
# Sync cadence advertised to print agents, in ms. Clamped to [500, 5000]; raising it
# reduces sync traffic at the cost of print latency.
SPOOLER_SYNC_INTERVAL_MS=500
# External order intake stays unavailable until the operator configures a
# dedicated call_center actor and generated secrets.
ORDER_INTAKE_ENABLED=false
ORDER_INTAKE_CLIENT_ID=pos-order-intake
ORDER_INTAKE_API_KEY_SHA256=
ORDER_INTAKE_QUOTE_SECRET=
ORDER_INTAKE_ACTOR_USER_ID=
ORDER_INTAKE_QUOTE_TTL_SECONDS=300
ORDER_INTAKE_RATE_LIMIT_MAX=120
ORDER_INTAKE_CREATE_RATE_LIMIT_MAX=30
ORDER_INTAKE_ACTIVE_HOLD_LIMIT=200
