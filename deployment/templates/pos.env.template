# CORS_ORIGIN is intentionally unset: cross-origin browsers are denied while terminals use the frontend served from this same host.
PORT={{POS_PORT}}
NODE_ENV=production
ENFORCE_HTTPS=false
# Registered-browser access remains disabled on LAN-IP terminals until an operator provisions a stable HTTPS origin.
DEVICE_AUTH_ALLOWED_ORIGINS=http://localhost:{{POS_PORT}}
DB_HOST=127.0.0.1
DB_PORT={{DB_PORT}}
DB_USER=posapp_runtime
DB_PASSWORD={{DB_APP_PASSWORD}}
DB_NAME=posapp
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
SPOOLER_KEY={{SPOOLER_KEY}}
# Sync cadence advertised to print agents, in ms. Clamped to [500, 5000]; raising it
# reduces sync traffic at the cost of print latency.
SPOOLER_SYNC_INTERVAL_MS=500
# External order intake stays unavailable until the operator configures a
# dedicated call_center actor and generated secrets.
ORDER_INTAKE_ENABLED=false
ORDER_INTAKE_CLIENT_ID=pos-order-intake
ORDER_INTAKE_API_KEY_SHA256=
ORDER_INTAKE_QUOTE_SECRET=
ORDER_INTAKE_ACTOR_USER_ID=
ORDER_INTAKE_QUOTE_TTL_SECONDS=300
ORDER_INTAKE_RATE_LIMIT_MAX=120
ORDER_INTAKE_CREATE_RATE_LIMIT_MAX=30
ORDER_INTAKE_ACTIVE_HOLD_LIMIT=200
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
SESSION_IDLE_TIMEOUT_MS=1800000
LOG_LEVEL=info
BACKUP_RETENTION_DAYS=7
POSAPP_DATA_DIR={{DATA_DIR}}
POSAPP_UPLOAD_DIR={{UPLOAD_DIR}}
POSAPP_LOG_DIR={{LOG_DIR}}
POSAPP_BACKUP_DIR={{BACKUP_DIR}}
MYSQLDUMP_PATH={{MARIADB_DUMP_EXE}}
